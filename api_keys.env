# DarkReaper API keys - FILL THESE BEFORE RUNNING AUTHENTICATED FEATURES
# WARNING: DO NOT SHARE this file.

# Dark web / Onion search engine API (used in dr_modules/*/darkweb_search.py)
Onion_search_engine_API_KEY=YOUR_Onion_search_engine_API_KEY_HERE



# Breach directory / RapidAPI (breaches_leaks.py)
BREACHDIRECTORY_RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY_HERE

# Dehashed API key (if you use Dehashed in breaches_leaks.py)
DEHASHED_API_KEY=YOUR_DEHASHED_API_KEY_HERE

# OCR.Space API key (image/text_extractor.py)
OCR_SPACE_API_KEY=YOUR_OCRSPACE_API_KEY_HERE

# Shodan API key (if any IP modules use Shodan)
SHODAN_API_KEY=YOUR_SHODAN_API_KEY_HERE

# IP info / GeoIP services (if applicable)
IPINFO_API_KEY=YOUR_IPINFO_API_KEY_HERE
GEOIP2_ACCOUNT_ID=YOUR_MAXMIND_ACCOUNT_ID_HERE
GEOIP2_LICENSE_KEY=YOUR_MAXMIND_LICENSE_KEY_HERE

# Any other optional keys you might add later
OTHER_API_KEY=YOUR_OTHER_KEY_HERE
